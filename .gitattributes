# Normalise line endings so a Windows checkout stops reporting unchanged
# files as modified. Without this, core.autocrlf=true left ~20 files
# permanently " M " with an empty diff, which hides real work.
* text=auto eol=lf

# Windows shells need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
