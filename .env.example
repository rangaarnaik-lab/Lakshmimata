# ── Supabase (required) ───────────────────────────────────────────────
# Get from: https://supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Owner Upstox token (Railway scanner only — do not use for other users' live LTP)
VITE_OWNER_UPSTOX_TOKEN=

# ── Upstox OAuth (server only — never VITE_) ─────────────────────────
# Create an app at https://account.upstox.com/developer/apps
# Redirect URL must match exactly, e.g. https://YOUR_DOMAIN/upstox/callback
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=
# openssl rand -hex 32  — required before Connect Upstox / Fyers can save a token
TOKEN_ENCRYPTION_KEY=

# ── Fyers OAuth (server only — never VITE_) ──────────────────────────
# Create an app at https://myapi.fyers.in/dashboard
# Permissions: Basic + Market Data (quotes + historical). Redirect must match exactly.
# Example: https://YOUR_DOMAIN/fyers/callback
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=
# A self-use Fyers app only authorises the account that created it; every other
# Fyers client gets "invalid appId" after logging in. List the emails allowed to
# see the Fyers card until Fyers converts this into a common (third-party) app
# via api-support@fyers.in. Comma separated. Blank = offer Fyers to everyone.
FYERS_ALLOWED_EMAILS=

# ── Razorpay (payments) ───────────────────────────────────────────────
# Dashboard → API Keys → Key Id (rzp_test_… or rzp_live_…)
# Leave blank to show the payment page without live checkout.
VITE_RAZORPAY_KEY_ID=

# ── Our Chart intraday (1/3/5/15) ─────────────────────────────────────
# Soft kill for the UI. Set to 0 to hide intervals even if Railway is writing.
# Server master switch is Railway ENABLE_INTRADAY_1M=0|1 (also published on
# scan_meta.features.intraday_1m — UI follows that without redeploying).
# VITE_ENABLE_INTRADAY_CHART=1

# Public bot username (no @). The secret token is Railway TELEGRAM_BOT_TOKEN only.
# VITE_TELEGRAM_BOT_USERNAME=LakshmiMata_bot
