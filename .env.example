# ── Supabase (required) ───────────────────────────────────────────────
# Get from: https://supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Owner Upstox Token (optional but recommended) ─────────────────────
# Set this to YOUR Upstox access token.
# Users will then NOT need to enter a token — they just sign in and scan.
# Leave blank to require each user to enter their own token.
VITE_OWNER_UPSTOX_TOKEN=your_upstox_access_token_here

# ── Razorpay (payments) ───────────────────────────────────────────────
# Dashboard → API Keys → Key Id (rzp_test_… or rzp_live_…)
# Leave blank to show the payment page without live checkout.
VITE_RAZORPAY_KEY_ID=

# ── Our Chart intraday (1/3/5/15) ─────────────────────────────────────
# Soft kill for the UI. Set to 0 to hide intervals even if Railway is writing.
# Server master switch is Railway ENABLE_INTRADAY_1M=0|1 (also published on
# scan_meta.features.intraday_1m — UI follows that without redeploying).
# VITE_ENABLE_INTRADAY_CHART=1

# Public bot username (no @). The secret token is Railway TELEGRAM_BOT_TOKEN only.
# VITE_TELEGRAM_BOT_USERNAME=LakshmiMata_bot
