//@version=5
indicator(title='Lakshmi Mata:Volume', shorttitle='Lakshmi Mata-Volume', format=format.volume, precision=2)

// ── Inputs ──────────────────────────────────────────────────────────────────
Show_IV = input(true, "Show Institutional Volume(IV)", group="Volume", inline="IV")
lookback_Period_IV = input.int(defval=10, minval=5, maxval=500, title="; Lookback Period to find IV", group="Volume", inline="IV")

Show_PP = input(true, "Show Pivot Pocket Volume", group="Volume", inline="PP")
lookback_Period_PP = input.int(defval=10, minval=5, maxval=500, title=";Lookback Period to find PP", group="Volume", inline="PP", tooltip="Pocket Pivot Volumes (PPV): an up-day volume greater than the highest down-day volume of the last N down-days. Bullish signal — not necessarily a buy signal.")

Show_AVG_Volume = input(true, "Draw Average Volume", group="Volume", inline="Average Volume")
MA_Length = input.int(defval=10, minval=5, maxval=500, title="; MA Length", group="Volume", inline="Average Volume")

lookback_Period_AVG = input.int(defval=50, minval=5, maxval=500, title="Lookback Period to calculate Avg.Volume , Relative Volume", group="Volume", inline="Lookback Period to calculate IV")
lookback_Period_Up_down = input.int(defval=50, minval=5, maxval=500, title="Lookback Period to calculate U/D Ratio", group="Volume", inline="Lookback Period to calculate IV", tooltip="The Up/Down Volume Ratio is a tool utilized by investors.com. A 50-day ratio derived by dividing total volume on up days by total volume on down days. A ratio greater than 1.0 implies positive demand.")

Show_LowVol_BG = input.bool(true, "Highlight Low Volume Bars", group="Volume", tooltip="Background when today's volume is below 50% of the volume MA.")
Show_HVT_Labels = input.bool(true, "Show Highest-Volume Labels (IPO/Year/Quarter/Month)", group="Volume")
Show_BullSnort = input.bool(true, "Show Bull Snort", group="Volume", inline="BS", tooltip="Bull Snort: Vol >= 3x 50-day avg + up day + DCR >= 65%. Shows lavender BG and bull icon. Ex: 50d avg 80K, vol 280K, DCR 90% = Bull Snort.")
bullSnort_RVol_Mult = input.float(3.0, "Min Rel Vol (× 50d Avg)", minval=2.0, step=0.5, group="Volume", inline="BS", tooltip="Volume ≥ this multiple of the fixed 50-day average volume (Oliver Kell Bull Snort).")
bullSnort_DCR_Min = input.float(65.0, "Min DCR %", minval=50.0, maxval=90.0, group="Volume", inline="BS", tooltip="Close in top portion of day's range.")
bullSnort_BG_Color = input.color(color.new(color.rgb(210, 170, 230), 78), "Bull Snort BG Color", group="Volume")

showDisclaimer = input.bool(true, title="Show Disclaimer")
Show_table = input(true, "Show Volume Information Table", group="Volume Information Table")
tableposition = input.string(defval=position.top_center, title="Table Position", inline="Heading", options=[position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_right], group="Volume Information Table")
table_text_size = input.string(defval=size.auto, title="Table Text Size", inline="Heading", options=[size.auto, size.tiny, size.small], group="Volume Information Table")
Var_table_color = input.color(color.white, title="Table_color", inline="Heading", group="Volume Information Table")
background_color = input.color(color.teal, title="Heading_Background_color", inline="Heading", group="Volume Information Table")
Var_text_color = input.color(color.white, title="Heading_Text_color", inline="Heading", group="Volume Information Table")
Var_Text_color = input.color(color.black, title="Text_color", inline="Heading", group="Volume Information Table")

Show_Notes = input.bool(false, "Show Signal Notes Panel", group="Signal Notes")
notes_position = input.string(defval=position.bottom_right, title="Notes Position", options=[position.top_left, position.top_center, position.top_right, position.middle_left, position.middle_right, position.bottom_left, position.bottom_center, position.bottom_right], group="Signal Notes")
notes_text_size = input.string(defval=size.small, title="Notes Text Size", options=[size.tiny, size.small, size.auto], group="Signal Notes")
notes_header_color = input.color(color.teal, title="Notes Header Color", group="Signal Notes")
notes_bg_color = input.color(color.new(color.white, 10), title="Notes Background", group="Signal Notes")

// ── Core calculations ───────────────────────────────────────────────────────
greenDay = close > open
upday = close > close[1]
barRange = high - low
daily_closing_range1 = barRange > 0 ? (close - low) / barRange * 100 : na
daily_closing_range = not na(daily_closing_range1) and daily_closing_range1 > 50

volMA = ta.sma(volume, MA_Length)
highestClose = ta.highest(volume[1], lookback_Period_IV)

// Highest down-day volume within lookback (red candles: close < open)
highestDownVol = 0.0
for i = 1 to lookback_Period_PP
    if close[i] < open[i]
        highestDownVol := math.max(highestDownVol, volume[i])

IVDay = volume >= (2 * highestClose) and greenDay and upday and daily_closing_range
isPocketPivot = close > open and volume > highestDownVol and volume > volMA and not IVDay

// ── Count pocket pivots & IBV in lookback window ────────────────────────────
pivotCount = 0
IBVcount = 0
for i = 0 to lookback_Period_PP - 1
    pivotCount += isPocketPivot[i] ? 1 : 0
    IBVcount += IVDay[i] ? 1 : 0

// ── Table metrics ───────────────────────────────────────────────────────────
AVG_Volume_table = ta.sma(volume, lookback_Period_AVG)
REL_Volume_table = (volume / AVG_Volume_table) * 100

bullSnort_AvgVol = ta.sma(volume, 50)
relVolMult = bullSnort_AvgVol > 0 ? volume / bullSnort_AvgVol : na
isBullSnort = not na(relVolMult) and relVolMult >= bullSnort_RVol_Mult and close > close[1] and not na(daily_closing_range1) and daily_closing_range1 >= bullSnort_DCR_Min

upVol = close > close[1] ? volume : 0.0
dnVol = close < close[1] ? volume : 0.0
sumUp = math.sum(upVol, lookback_Period_Up_down)
sumDn = math.sum(dnVol, lookback_Period_Up_down)
upDnVolRatio = sumDn > 0 ? sumUp / sumDn : na

lookback_Period_Up_down_color = upDnVolRatio < 1 ? color.red : upDnVolRatio < 3 ? color.rgb(113, 170, 103) : color.green
Changeinvolume = volume[1] > 0 ? ((volume - volume[1]) / volume[1]) * 100 : na
dcr_color = na(daily_closing_range1) ? color.gray : daily_closing_range1 >= 65 ? color.green : daily_closing_range1 >= 50 ? color.rgb(113, 170, 103) : color.red
change_color = na(Changeinvolume) ? color.gray : Changeinvolume >= 0 ? color.green : color.red
rel_vol_color = REL_Volume_table >= 200 ? color.green : REL_Volume_table >= 100 ? color.rgb(113, 170, 103) : color.red

// ── Highest-volume-since tracking ─────────────────────────────────────────────
var float ipoVolume = na
var int ipoBarIndex = na
if barstate.isfirst
    ipoVolume := volume
    ipoBarIndex := bar_index

var float highestVolSinceIPO = na
if bar_index >= ipoBarIndex
    highestVolSinceIPO := na(highestVolSinceIPO) ? volume : math.max(highestVolSinceIPO, volume)
isHVT_IPO = volume == highestVolSinceIPO

var int currentYear = na
var float highestVolThisYear = na
if na(currentYear) or year != currentYear
    currentYear := year
    highestVolThisYear := volume
else
    highestVolThisYear := math.max(highestVolThisYear, volume)
isHVT_Year = volume == highestVolThisYear

quarter = math.ceil(month / 3.0)
var int currentQuarter = na
var float highestVolThisQuarter = na
if na(currentQuarter) or quarter != currentQuarter or year != currentYear
    currentQuarter := quarter
    highestVolThisQuarter := volume
else
    highestVolThisQuarter := math.max(highestVolThisQuarter, volume)
isHVT_Quarter = volume == highestVolThisQuarter

var int currentMonth = na
var float highestVolThisMonth = na
if na(currentMonth) or month != currentMonth or year != currentYear
    currentMonth := month
    highestVolThisMonth := volume
else
    highestVolThisMonth := math.max(highestVolThisMonth, volume)
isHVT_Month = volume == highestVolThisMonth

isJanFirst = month == 1 and dayofmonth == 1
volChangePct1 = volume[1] > 0 ? (volume - volume[1]) / volume[1] * 100 : na
isHYDay = isHVT_Year and not isHVT_IPO and (not isJanFirst or (not na(volChangePct1) and Changeinvolume > 500)) and close > open and volume > highestDownVol and volume > volMA

Var_Comments = isHVT_IPO ? "All-Time High Vol (HT)" : isHYDay ? "Year High Vol (HY)" : IVDay ? "Institutional Buy Volume" : isBullSnort ? "Bull Snort" : isPocketPivot ? "Pivot Pocket Volume" : isHVT_Quarter ? "Quarter High Vol (HQ)" : isHVT_Month ? "Month High Vol (M)" : "NA"

Volume_color = IVDay ? color.rgb(33, 149, 243, 9) : isPocketPivot ? color.green : close < open ? color.red : color.gray
volMid = volume * 0.5

// ── Bull Snort / low-volume background ───────────────────────────────────────
lowVolCondition = volume < volMA * 0.5
bgcolor(
     Show_BullSnort and isBullSnort ? bullSnort_BG_Color :
     Show_LowVol_BG and lowVolCondition ? color.rgb(238, 231, 238) :
     na,
     title="Bull Snort / Low Volume Background")

if Show_HVT_Labels and isHVT_IPO
    label.new(bar_index, volMid, "🚀", style=label.style_none, textcolor=color.black, size=size.small)
    label.new(bar_index, -1.15, "HT", style=label.style_label_up, color=color.white, textcolor=color.black, size=size.tiny)

if Show_HVT_Labels and isHYDay
    label.new(bar_index, volMid, "🔥", style=label.style_none, textcolor=color.black, size=size.small)
    label.new(bar_index, -1.15, "HY", style=label.style_label_up, color=color.white, textcolor=color.black, size=size.tiny)

if Show_HVT_Labels and isHVT_Quarter and not isHVT_IPO and not isHVT_Year
    label.new(bar_index, -1.15, "HQ", style=label.style_label_up, color=color.white, textcolor=color.black, size=size.tiny)

if Show_HVT_Labels and isHVT_Month and not isHVT_IPO and not isHVT_Year and not isHVT_Quarter
    label.new(bar_index, -1.05, "M", style=label.style_label_up, color=color.white, textcolor=color.black, size=size.tiny)

// ── Volume information table ──────────────────────────────────────────────────
var table ATHtable = table.new(tableposition, 8, 2, frame_color=color.gray, bgcolor=Var_table_color, border_width=1, frame_width=1, border_color=color.black)

if Show_table
    table.cell(ATHtable, 0, 0, "Volume", bgcolor=background_color, text_color=Var_text_color, text_size=table_text_size)
    table.cell(ATHtable, 0, 1, str.tostring(volume, format.volume), text_color=Var_Text_color, text_size=table_text_size)

    table.cell(ATHtable, 1, 0, str.tostring(lookback_Period_AVG) + " Bar Avg.Vol", bgcolor=background_color, text_color=Var_text_color, text_size=table_text_size)
    table.cell(ATHtable, 1, 1, str.tostring(AVG_Volume_table, format.volume), text_color=Var_Text_color, text_size=table_text_size)

    table.cell(ATHtable, 2, 0, str.tostring(lookback_Period_AVG) + " Bar Rel.Vol", bgcolor=background_color, text_color=Var_text_color, tooltip="Rel.Vol = Current Volume / Average volume of lookback period", text_size=table_text_size)
    table.cell(ATHtable, 2, 1, str.tostring(math.round(REL_Volume_table)) + "%", text_color=Var_Text_color, bgcolor=rel_vol_color, text_size=table_text_size)

    table.cell(ATHtable, 3, 0, str.tostring(lookback_Period_Up_down) + " Bar Up/Down Vol Ratio", bgcolor=background_color, text_color=Var_text_color, tooltip="Total up-day volume divided by total down-day volume over the lookback period.", text_size=table_text_size)
    table.cell(ATHtable, 3, 1, str.tostring(math.round(upDnVolRatio, 2)), text_color=Var_Text_color, bgcolor=lookback_Period_Up_down_color, text_size=table_text_size)

    table.cell(ATHtable, 4, 0, "DCR%", bgcolor=background_color, text_color=Var_text_color, tooltip="(Close - Low) / (High - Low) * 100", text_size=table_text_size)
    table.cell(ATHtable, 4, 1, str.tostring(math.round(daily_closing_range1, 2)) + "%", text_color=Var_Text_color, bgcolor=dcr_color, text_size=table_text_size)

    table.cell(ATHtable, 5, 0, "Change%", bgcolor=background_color, text_color=Var_text_color, tooltip="((Present day - Previous day) / Previous day) * 100", text_size=table_text_size)
    table.cell(ATHtable, 5, 1, str.tostring(math.round(Changeinvolume, 2)) + "%", text_color=Var_Text_color, bgcolor=change_color, text_size=table_text_size)

    table.cell(ATHtable, 6, 0, "No Of PPV & IBV in last " + str.tostring(lookback_Period_PP) + " bars", bgcolor=background_color, text_color=Var_text_color, tooltip="Pocket Pivot Volume (PPV) count and IBV (Institutional buy volume) count", text_size=table_text_size)
    table.cell(ATHtable, 6, 1, "PPV-" + str.tostring(pivotCount) + " and IBV-" + str.tostring(IBVcount), text_color=Var_Text_color, text_size=table_text_size)

    table.cell(ATHtable, 7, 0, "Comments", bgcolor=background_color, text_color=Var_text_color, tooltip="HT, HY, IBV, Bull Snort, PPV, HQ, or M for the current bar.", text_size=table_text_size)
    table.cell(ATHtable, 7, 1, Var_Comments, text_color=Var_Text_color, text_size=table_text_size)

// ── Signal notes panel ────────────────────────────────────────────────────────
var table notesTable = table.new(notes_position, 2, 7, frame_color=color.gray, bgcolor=notes_bg_color, border_width=1, frame_width=1, border_color=color.black)

if Show_Notes
    table.cell(notesTable, 0, 0, "Signal", bgcolor=notes_header_color, text_color=color.white, text_size=notes_text_size)
    table.cell(notesTable, 1, 0, "Guide & Example", bgcolor=notes_header_color, text_color=color.white, text_size=notes_text_size)

    table.cell(notesTable, 0, 1, "Rel Vol (" + str.tostring(lookback_Period_AVG) + "d)", text_color=Var_Text_color, text_size=notes_text_size, tooltip="Today's volume vs N-day average in the main table.")
    table.cell(notesTable, 1, 1, "<100% = quiet day\n100% = average\n>100% = active\n≥200% = strong\nEx: Avg 1L, today 64K → 64%", text_color=Var_Text_color, text_size=notes_text_size)

    table.cell(notesTable, 0, 2, "Bull Snort 🐂", text_color=Var_Text_color, text_size=notes_text_size)
    table.cell(notesTable, 1, 2, "Vol ≥ " + str.tostring(bullSnort_RVol_Mult, "#.#") + "× 50d avg + up day + DCR ≥ " + str.tostring(bullSnort_DCR_Min, "#") + "%\nEx: 50d avg 80K, vol 280K, DCR 90% → Bull Snort", text_color=Var_Text_color, text_size=notes_text_size)

    table.cell(notesTable, 0, 3, "HT 🚀", text_color=Var_Text_color, text_size=notes_text_size)
    table.cell(notesTable, 1, 3, "Highest volume since IPO / listing\nEx: Past max 5M, today 6.2M → HT", text_color=Var_Text_color, text_size=notes_text_size)

    table.cell(notesTable, 0, 4, "HY 🔥", text_color=Var_Text_color, text_size=notes_text_size)
    table.cell(notesTable, 1, 4, "Highest volume this calendar year\n+ green day + vol > down-day high + vol MA\nEx: 2026 high was 3M, today 3.8M green → HY", text_color=Var_Text_color, text_size=notes_text_size)

    table.cell(notesTable, 0, 5, "Today", bgcolor=notes_header_color, text_color=color.white, text_size=notes_text_size)
    table.cell(notesTable, 1, 5, "Live Values", bgcolor=notes_header_color, text_color=color.white, text_size=notes_text_size)

    todayRelVol = str.tostring(math.round(REL_Volume_table)) + "% " + str.tostring(lookback_Period_AVG) + "d Rel"
    today50d = not na(relVolMult) ? str.tostring(relVolMult, "#.#") + "× 50d avg" : "50d n/a"
    todayDcr = not na(daily_closing_range1) ? "DCR " + str.tostring(math.round(daily_closing_range1, 1)) + "%" : "DCR n/a"
    table.cell(notesTable, 0, 6, Var_Comments, text_color=Var_Text_color, bgcolor=Var_Comments != "NA" ? color.new(color.green, 85) : notes_bg_color, text_size=notes_text_size)
    table.cell(notesTable, 1, 6, todayRelVol + " | " + today50d + " | " + todayDcr, text_color=Var_Text_color, text_size=notes_text_size)

// ── Disclaimer ──────────────────────────────────────────────────────────────
var table disclaimerTable = table.new(position.bottom_left, 1, 1, border_width=1)
if showDisclaimer
    table.cell(disclaimerTable, 0, 0, "⚠️ This script is for educational purposes only. It does not constitute financial advice. Use at your own risk.", text_color=color.white, bgcolor=color.black)

// ── Plots ─────────────────────────────────────────────────────────────────────
plot(volume, style=plot.style_columns, color=Volume_color, title="Volume")
plot(Show_AVG_Volume ? volMA : na, style=plot.style_line, color=color.rgb(20, 20, 20), title="Average Volume")
plot(0, "Zero line", color.gray)

plotchar(IVDay and Show_IV, title="IBV", char="", location=location.abovebar, color=color.rgb(18, 19, 18), size=size.tiny, text="IBV")
plotchar(IVDay and Show_IV, title="IBV_symbol", char="▲", location=location.bottom, color=color.rgb(221, 15, 211), size=size.tiny)
plotchar(isPocketPivot and Show_PP, title="PPV", char="★", location=location.bottom, color=color.rgb(17, 16, 16), size=size.tiny)
plotchar(isBullSnort and Show_BullSnort, title="Bull Snort", char="🐂", location=location.abovebar, color=color.rgb(128, 0, 128), size=size.tiny)

alertcondition(IVDay, title="IBV", message="Institutional Buy Volume Alert on {{ticker}} @ {{close}} on {{interval}} Timeframe")
alertcondition(isPocketPivot, title="PPV", message="Pivot pocket Volume Alert on {{ticker}} @ {{close}} on {{interval}} Timeframe")
alertcondition(isBullSnort, title="Bull Snort", message="Bull Snort on {{ticker}} @ {{close}} on {{interval}} Timeframe")
