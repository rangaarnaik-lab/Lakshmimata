+def _gemini_api_keys_pool(*features: str) -> list[str]:
+    """All unique Gemini keys — feature-specific keys first, then every GEMINI_API_KEY*."""
+    keys: list[str] = []
+    seen: set[str] = set()
+    for feat in features:
+        k = _gemini_api_key(feat) if feat else _gemini_api_key('')
+        if k and k not in seen:
+            keys.append(k)
+            seen.add(k)
+    for name in sorted(os.environ):
+        if not name.startswith('GEMINI_API_KEY'):
+            continue
+        k = (os.environ.get(name) or '').strip()
+        if k and k not in seen:
+            keys.append(k)
+            seen.add(k)
+    return keys
+
+
+_GEMINI_RR_IDX = 0
+
+
+def _gemini_env_key_var_names() -> list[str]:
+    """Railway env var names that hold a Gemini key (for startup logs)."""
+    return sorted(
+        n for n in os.environ
+        if n.startswith('GEMINI_API_KEY') and (os.environ.get(n) or '').strip()
+    )
+
+
+def _gemini_api_keys_pool_rotated(*features: str) -> list[str]:
+    """Pool with round-robin start — spreads load across 5–6+ keys before any hits quota."""
+    global _GEMINI_RR_IDX
+    pool = _gemini_api_keys_pool(*features)
+    if not pool:
+        return []
+    start = _GEMINI_RR_IDX % len(pool)
+    _GEMINI_RR_IDX += 1
+    return pool[start:] + pool[:start]
+
+
+async def _gemini_generate_rotating(session: aiohttp.ClientSession, *,
+                                    features: tuple[str, ...], model: str, body: dict,
+                                    timeout_s: float, symbol: str, label: str,
+                                    priority: bool = False):
+    """Try each API key in the pool before giving up (free-tier daily limits are per-key)."""
+    keys = _gemini_api_keys_pool_rotated(*features)
+    if not keys:
+        return 0, {}, '', False, None
+    last_status, last_data, last_body = 0, {}, ''
+    all_hard_quota = True
+    for i, api_key in enumerate(keys):
+        url = (f"https://generativelanguage.googleapis.com/v1beta/models/"
+               f"{model}:generateContent?key={api_key}")
+        status, data, body_txt = await _gemini_generate(
+            session, url, body, timeout_s, api_key=api_key, priority=priority)
+        if status == 200:
+            return status, data, body_txt, False, api_key
+        last_status, last_data, last_body = status, data, body_txt
+        hard_quota = status == 429 and _gemini_quota_exhausted(body_txt)
+        if hard_quota:
+            log.warning(
+                f"⚠️ Gemini {label} for {symbol} ({status}) — HARD QUOTA on "
+                f"{_gemini_key_fingerprint(api_key)}"
+                + (f" — trying next key ({i + 2}/{len(keys)})" if i + 1 < len(keys) else ""))
+            if i + 1 < len(keys):
+                continue
+        elif status == 429:
+            all_hard_quota = False
+            log.warning(
+                f"⚠️ Gemini {label} for {symbol} — RPM 429 on "
+                f"{_gemini_key_fingerprint(api_key)}"
+                + (f" — trying next key ({i + 2}/{len(keys)})" if i + 1 < len(keys) else ""))
+            if i + 1 < len(keys):
+                await asyncio.sleep(max(5, int(os.getenv('GEMINI_429_BACKOFF_SECONDS', '15'))))
+                continue
+        else:
+            all_hard_quota = False
+            break
+    return last_status, last_data, last_body, all_hard_quota and last_status == 429, None
+
